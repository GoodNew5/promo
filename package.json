{
  "name": "my-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint ./src/ --fix",
    "format": "prettier --write src/",
    "build-only": "vite build",
    "preview": "vite preview",
    "mock-server": "json-server --watch ./mock-server/db.json --port 3009",
    "mock-server:generate-posts": "npm run setNode json-server ./mock-server/helpers/generate-posts.js",
    "setNode": "npx -p node@22"
  },
  "dependencies": {
    "@vueuse/core": "^11.2.0",
    "browser-dtector": "^4.1.0",
    "pinia": "^2.2.5",
    "v3-scroll-lock": "^1.3.2",
    "vue": "^3.5.12",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.4.5",
    "vue3-toaster": "^1.0.0"
  },
  "devDependencies": {
    "@digitalacorn/vite-plugin-svg-icons": "^3.0.0-pre.2",
    "@eslint/js": "^9.14.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass-embedded": "^1.80.5",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.12.2",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8",
    "lint-staged": "^15.3.0",
    "simple-git-hooks": "^2.11.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run format"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
